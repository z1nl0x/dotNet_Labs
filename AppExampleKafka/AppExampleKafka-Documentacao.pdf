(\057\057 Emite o par de tokens e persiste o hash do refresh \050usado em Register e Login\051) Tj
T*
(private async Task\074AuthResult\076 IssueTokensAsync\050User user\054 CancellationToken ct\051) Tj
T*
(\173) Tj
T*
(    var \050accessToken\054 accessExpires\051 \075 tokenService\056GenerateAccessToken\050user\051\073) Tj
T*
(    var \050rawRefresh\054 refreshHash\054 refreshExpires\051 \075 tokenService\056GenerateRefreshToken\050\051\073) Tj
T*
(    await unitOfWork\056RefreshTokens\056AddAsync\050) Tj
T*
(        new RefreshToken\050user\056Id\054 refreshHash\054 refreshExpires\051\054 ct\051\073) Tj
T*
(    await unitOfWork\056SaveChangesAsync\050ct\051\073) Tj
T*
(    var response \075 new AuthResponse\050accessToken\054 accessExpires\054 mapper\056Map\074UserDto\076\050user\051\051\073) Tj
T*
(    return new AuthResult\050response\054 rawRefresh\054 refreshExpires\051\073) Tj
T*
(\175) Tj
T*
T*
(public async Task\074AuthResult\076 RefreshAsync\050string refreshToken\054 CancellationToken ct\051) Tj
T*
(\173) Tj
T*
(    if \050string\056IsNullOrWhiteSpace\050refreshToken\051\051) Tj
T*
(        throw new UnauthorizedException\050\042Refresh token ausente\056\042\051\073) Tj
T*
T*
(    var hash \075 tokenService\056HashRefreshToken\050refreshToken\051\073) Tj
T*
(    var stored \075 await unitOfWork\056RefreshTokens\056GetByTokenHashAsync\050hash\054 ct\051\073) Tj
T*
(    if \050stored is null \174\174 \041stored\056IsActive\051) Tj
T*
(        throw new UnauthorizedException\050\042Refresh token inv\341lido ou expirado\056\042\051\073) Tj
T*
T*
(    var user \075 await unitOfWork\056Users\056GetByIdAsync\050stored\056UserId\054 ct\051) Tj
T*
(        \077\077 throw new UnauthorizedException\050\042Usu\341rio n\343o encontrado\056\042\051\073) Tj
T*
T*
(    \057\057 ROTA\307\303O\072 revoga o antigo\054 emite o novo\054 registra o v\355nculo) Tj
T*
(    var \050accessToken\054 accessExpires\051 \075 tokenService\056GenerateAccessToken\050user\051\073) Tj
T*
(    var \050rawRefresh\054 refreshHash\054 refreshExpires\051 \075 tokenService\056GenerateRefreshToken\050\051\073) Tj
T*
(    stored\056Revoke\050replacedByTokenHash\072 refreshHash\051\073) Tj
T*
(    await unitOfWork\056RefreshTokens\056AddAsync\050) Tj
T*
(        new RefreshToken\050user\056Id\054 refreshHash\054 refreshExpires\051\054 ct\051\073) Tj
T*
(    await unitOfWork\056SaveChangesAsync\050ct\051\073) Tj
T*
T*
(    var response \075 new AuthResponse\050accessToken\054 accessExpires\054 mapper\056Map\074UserDto\076\050user\051\051\073) Tj
T*
(    return new AuthResult\050response\054 rawRefresh\054 refreshExpires\051\073) Tj
T*
(\175) Tj
T*
ET
Q

